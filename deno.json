{
  "version": "1.0.0",
  "nodeModulesDir": "manual",
  "unstable": [
    "kv"
  ],
  "tasks": {
    "dev": "deno run -A --env-file npm:vite",
    "build": "vite build",
    "start": "deno serve -A --env-file _fresh/server.js",
    "check": "deno check main.ts routes/ islands/ scripts/set_webhook.ts tests/",
    "set-webhook": "deno run --allow-net --allow-env scripts/set_webhook.ts",
    "test": "deno test --allow-env --allow-net --allow-read --allow-write --unstable-kv tests/"
  },
  "deploy": {
    "framework": "fresh",
    "install": "deno install",
    "build": "deno task build",
    "predeploy": "deno task set-webhook"
  },
  "exclude": [
    "**/_fresh/*",
    "graphify-out/"
  ],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "grammy": "https://deno.land/x/grammy@v1.45.1/mod.ts",
    "https://cdn.skypack.dev/debug@4.4.3": "./src/vendor/debug.ts",
    "@grammyjs/debug": "jsr:@grammyjs/debug@^0.3.1",
    "@std/assert": "jsr:@std/assert@^1.0.11"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
