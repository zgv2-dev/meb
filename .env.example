# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Public Domain of your hosted server / Deno Deploy project
# Example: https://your-project.deno.dev or https://example.com
PUBLIC_DOMAIN=

# Optional: Specific Webhook URL (if different from ${PUBLIC_DOMAIN}/webhook)
WEBHOOK_URL=

# Optional webhook secret token (defaults to sha256 of BOT_TOKEN)
WEBHOOK_SECRET=

# Server Port (default 8000)
PORT=8000

# Delay between audio posts per channel in ms (default 1500)
POST_PACING_MS=1500

# Max retries for rate-limited requests
MAX_RETRIES=5

# Max time one audio update may spend publishing, retries included (ms).
# Must stay below Telegram's 60s webhook timeout minus 10s, or tracks get double-posted.
UPDATE_BUDGET_MS=40000
