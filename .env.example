# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Public Domain of your hosted server / Deno Deploy project
# Example: https://your-project.deno.dev or https://example.com
PUBLIC_DOMAIN=

# Optional: Specific Webhook URL (if different from ${PUBLIC_DOMAIN}/${BOT_TOKEN})
WEBHOOK_URL=

# Optional Webhook Secret Token for security
WEBHOOK_SECRET=

# Server Port (default 8000)
PORT=8000

# Delay between audio posts per channel in ms (default 1500)
POST_PACING_MS=1500

# Max retries for rate-limited requests
MAX_RETRIES=5
