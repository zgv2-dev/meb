# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Webhook URL (Required for Deno Deploy if not auto-registered)
# Example: https://your-project.deno.dev/webhook
WEBHOOK_URL=

# Optional Webhook Secret Token for security
WEBHOOK_SECRET=

# Server Port (default 8000)
PORT=8000

# Delay between audio posts per channel in ms (default 1500)
POST_PACING_MS=1500

# Max retries for rate-limited requests
MAX_RETRIES=5
